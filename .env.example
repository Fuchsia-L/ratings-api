SYNC_TOKEN=replace_with_openssl_rand_hex_32
INTERNAL_TOKEN=replace_with_a_different_random_hex_32_token
# 只读查询 token（mooring Claude 用）。可选：不填只是关掉只读入口，服务照常起。
# 仅能访问 GET /v1/schedule/day 与 GET /v1/schedule/window，拿去调别的端点 403。
READONLY_TOKEN=replace_with_a_third_random_hex_32_token
# 写 token（v3，Claude 增删改课程/待办用）。可选：不填只是关掉写端点，服务照常起。
# 能调写端点（POST/PATCH/DELETE 课程与待办）+ 查询端点 + 单条读；
# 调同步端点（app 的批量推送）会 403。
WRITE_TOKEN=replace_with_a_fourth_random_hex_32_token
PORT=3000
DB_PATH=./data/ratings.db
